<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/ObsidianSectionTitle"
            android:text="Audio" />

        <TextView
            style="@style/ObsidianSectionSubtitle"
            android:text="Master levels for the client session." />

        <TextView
            style="@style/ObsidianFieldLabel"
            android:text="Master volume" />

        <SeekBar
            android:id="@+id/audio_master"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:id="@+id/audio_master_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/obs_text_muted"
            android:textSize="13sp" />

        <TextView
            style="@style/ObsidianFieldLabel"
            android:text="Music volume" />

        <SeekBar
            android:id="@+id/audio_music"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:id="@+id/audio_music_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/obs_text_muted"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/audio_mute_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:checked="true"
            android:text="Mute login intro music"
            android:textColor="@color/obs_text" />
    </LinearLayout>
</ScrollView>
