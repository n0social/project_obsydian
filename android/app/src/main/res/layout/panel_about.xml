<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/ObsidianSectionTitle"
            android:text="About" />

        <TextView
            style="@style/ObsidianSectionSubtitle"
            android:text="Clean-room Vanilla client shell for external private servers." />

        <TextView
            android:id="@+id/about_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/obs_text"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="Target: Samsung Galaxy Tab A9+ landscape · keyboard &amp; mouse · extracted classic Data."
            android:textColor="@color/obs_text_muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="No Blizzard assets ship in the APK. Bring your own extract."
            android:textColor="@color/obs_text_muted"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
